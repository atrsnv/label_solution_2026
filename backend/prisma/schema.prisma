// Prisma schema for Music Label ERP
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite не поддерживает enum: используем строки + комментарии-валидаторы.
// Role:         "ADMIN" | "ARTIST"
// TrackStatus:  "PENDING" | "APPROVED" | "ERROR"
// SplitStatus:  "PENDING" | "ACCEPTED" | "DISPUTED"
// PayoutStatus: "REQUESTED" | "PAID" | "REJECTED"

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         String   @default("ARTIST")

  // только для артистов: процент лейбла (0..100), который "съедается" с каждого трека
  labelShare   Float    @default(30)
  // текущий баланс артиста (доступный к выводу)
  balance      Float    @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // отношения
  ownedTracks  Track[]    @relation("TrackOwner")
  splits       Split[]
  earnings     Earning[]
  payouts      Payout[]
  invites      Invite[]   @relation("InviteCreator")
}

model Track {
  id            String      @id @default(cuid())
  title         String
  coverUrl      String?
  releaseDate   DateTime
  status        String      @default("PENDING")

  // снимок процента лейбла на момент создания (чтобы изменения не ломали историю)
  labelShare    Float

  ownerId       String
  owner         User        @relation("TrackOwner", fields: [ownerId], references: [id])

  splits        Split[]
  earnings      Earning[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([ownerId])
}

model Split {
  id        String      @id @default(cuid())
  trackId   String
  userId    String      // участник (или сам автор, или приглашённый)
  share     Float       // процент от "не-лейбловой" части (0..100)
  status    String      @default("PENDING")

  track     Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([trackId, userId])
  @@index([userId])
}

model Report {
  id          String    @id @default(cuid())
  filename    String
  totalAmount Float     @default(0)
  rowsCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  earnings    Earning[]
}

model Earning {
  id        String   @id @default(cuid())
  trackId   String
  userId    String
  amount    Float
  period    String?  // например "2025-04"
  reportId  String?

  track     Track    @relation(fields: [trackId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  report    Report?  @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([trackId])
}

model Payout {
  id        String       @id @default(cuid())
  userId    String
  amount    Float
  status    String       @default("REQUESTED")

  user      User         @relation(fields: [userId], references: [id])

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

// Инвайт-ссылки / временные пароли для добавления артистов админом
model Invite {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String?
  used       Boolean  @default(false)
  createdById String
  createdBy   User    @relation("InviteCreator", fields: [createdById], references: [id])

  createdAt  DateTime @default(now())
  expiresAt  DateTime
}
