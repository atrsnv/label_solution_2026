// Prisma schema for Music Label ERP
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite не поддерживает enum: используем строки + комментарии-валидаторы.
// Role: "ADMIN" | "ARTIST"

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  role              String   @default("ARTIST")
  labelShare        Float    @default(10)
  datalensArtistId  String?
  payoutDetails     String?  // JSON: { type, fullName, bank, bik, account, phone }

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invites      Invite[]   @relation("InviteCreator")
  payouts      Payout[]
  releases     Release[]
  deals        Deal[]
}

model Deal {
  id            String   @id @default(cuid())
  artistId      String
  organization  String
  totalAmount   Float
  artistPercent Float
  artistAmount  Float
  labelAmount   Float
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  artist        User     @relation(fields: [artistId], references: [id])
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  status    String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED
  details   String?  // JSON snapshot of requisites at request time
  comment   String?  // admin comment on approve/reject
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  filename    String
  totalAmount Float    @default(0)
  rowsCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Инвайт-ссылки / временные пароли для добавления артистов админом
model Invite {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String?
  used       Boolean  @default(false)
  createdById String
  createdBy   User    @relation("InviteCreator", fields: [createdById], references: [id])

  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model Release {
  id            String   @id @default(cuid())
  userId        String
  title         String
  releaseDate   String
  collaborators String?  // JSON: [{name, email, role}]
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  coverUrl      String?
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

